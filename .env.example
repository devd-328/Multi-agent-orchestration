# Copy this file to .env and replace the placeholders.
# .env is gitignored. Do not commit real values.
LLM_PROVIDER=ollama
LLM_MODEL=replace-with-model-name
LLM_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=60
MAX_TASK_ATTEMPTS=3
MAX_REVIEW_REVISIONS=2
MAX_PLAN_ATTEMPTS=3
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=replace-with-your-search-api-key
SEARCH_TIMEOUT_SECONDS=20
MAX_SEARCH_QUERIES=3
MAX_RESULTS_PER_QUERY=5
MAX_SOURCE_CHARS=2000
MAX_RESEARCH_ATTEMPTS=3
MAX_REVIEW_EXCERPT_CHARS=2000
MAX_REVIEW_ATTEMPTS=3
MAX_GRAPH_STEPS=100
# Optional. Leave empty to review with LLM_MODEL.
REVIEWER_MODEL=
